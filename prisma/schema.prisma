generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ESTABLISHMENT
  FREELANCER
}

enum ProfileStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum JobStatus {
  OPEN
  IN_REVIEW
  FILLED
  CANCELLED
  FINISHED
}

enum PaymentType {
  DAILY
  HOURLY
  FIXED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SubscriptionProvider {
  MERCADO_PAGO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  AUTHORIZED
  PENDING
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

model User {
  id                 String    @id @default(cuid())
  supabaseAuthUserId String    @unique
  name               String
  email              String    @unique
  phone              String?
  role               UserRole
  emailVerifiedAt    DateTime?
  termsAcceptedAt    DateTime?
  trialStartsAt      DateTime
  trialEndsAt        DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  establishmentProfile EstablishmentProfile?
  freelancerProfile    FreelancerProfile?
  subscriptions        Subscription[]
  paymentHistory       PaymentHistory[]
  reviewsGiven         Review[]             @relation("Reviewer")
  reviewsReceived      Review[]             @relation("Reviewed")

  @@index([role])
  @@index([trialEndsAt])
}

model EstablishmentProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  tradeName   String
  legalName   String?
  cnpj        String?
  whatsapp    String?
  instagram   String?
  email       String?
  type        String?
  description String?
  profilePhotoUrl String?
  status      ProfileStatus @default(PENDING)

  cep          String?
  state        String?
  city         String?
  neighborhood String?
  street       String?
  number       String?
  complement   String?
  mainCnae     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts  JobPost[]

  @@index([status])
  @@index([city])
  @@index([neighborhood])
  @@index([street])
  @@index([tradeName])
}

model FreelancerProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  fullName        String
  whatsapp        String?
  instagram       String?
  email           String?
  city            String?
  neighborhood    String?
  street          String?
  cep             String?
  bio             String?
  experience      String?
  profilePhotoUrl String?
  averageRating   Decimal       @default(0) @db.Decimal(3, 2)
  status          ProfileStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    FreelancerSpecialty[]
  availability   Availability[]
  applications   JobApplication[]

  @@index([status])
  @@index([city])
  @@index([neighborhood])
}

model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freelancers FreelancerSpecialty[]
  jobPosts    JobPost[]

  @@index([active])
}

model FreelancerSpecialty {
  id           String   @id @default(cuid())
  freelancerId String
  specialtyId  String
  createdAt    DateTime @default(now())

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  specialty  Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, specialtyId])
}

model Availability {
  id           String    @id @default(cuid())
  freelancerId String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  available    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId, dayOfWeek])
}

model JobPost {
  id              String      @id @default(cuid())
  establishmentId String
  title           String
  description     String?
  specialtyId     String
  city            String
  neighborhood    String?
  street          String?
  number          String?
  cep             String?
  workDate        DateTime
  startTime       String
  endTime         String
  paymentType     PaymentType
  paymentValue    Int
  quantity        Int         @default(1)
  requirements    String?
  status          JobStatus   @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  establishment EstablishmentProfile @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  specialty     Specialty            @relation(fields: [specialtyId], references: [id])
  applications  JobApplication[]
  reviews       Review[]

  @@index([status])
  @@index([city])
  @@index([neighborhood])
  @@index([workDate])
  @@index([specialtyId])
}

model JobApplication {
  id           String            @id @default(cuid())
  jobPostId    String
  freelancerId String
  message      String?
  status       ApplicationStatus @default(PENDING)
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  jobPost    JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, freelancerId])
  @@index([status])
  @@index([freelancerId])
}

model Plan {
  id                            String   @id @default(cuid())
  role                          UserRole
  name                          String
  description                   String?
  priceCents                    Int
  currency                      String   @default("BRL")
  trialDays                     Int      @default(7)
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([role, name])
  @@index([active])
}

model Subscription {
  id                       String               @id @default(cuid())
  userId                   String
  planId                   String
  provider                 SubscriptionProvider @default(MERCADO_PAGO)
  status                   SubscriptionStatus   @default(TRIALING)
  mercadoPagoPreapprovalId String?              @unique
  mercadoPagoPreferenceId  String?              @unique
  mercadoPagoPayerId       String?
  startedAt                DateTime?
  trialEndsAt              DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan             @relation(fields: [planId], references: [id])
  paymentHistory PaymentHistory[]

  @@index([userId])
  @@index([status])
  @@index([provider])
}

model PaymentHistory {
  id                                String               @id @default(cuid())
  userId                            String
  subscriptionId                    String?
  provider                          SubscriptionProvider @default(MERCADO_PAGO)
  mercadoPagoPaymentId              String?
  mercadoPagoPreapprovalId          String?
  mercadoPagoAuthorizedPaymentId    String?
  externalReference                 String?
  protocol                          String?
  paymentCode                       String?
  status                            String
  statusDetail                      String?
  amountCents                       Int?
  currency                          String?
  paymentMethodId                   String?
  paymentTypeId                     String?
  installments                      Int?
  payerEmail                        String?
  paidAt                            DateTime?
  rawPayload                        Json?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, mercadoPagoPaymentId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([externalReference])
}

model MercadoPagoWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String?
  type        String?
  action      String?
  dataId      String?
  requestId   String?
  signature   String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([eventId])
  @@unique([requestId, dataId, action])
  @@index([dataId])
  @@index([processedAt])
}

model Review {
  id             String   @id @default(cuid())
  jobPostId      String
  reviewerUserId String
  reviewedUserId String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  jobPost      JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  reviewerUser User    @relation("Reviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewedUser User    @relation("Reviewed", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, reviewerUserId, reviewedUserId])
}
